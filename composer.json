{
    "name": "carlink/backend",
    "type": "project",
    "description": "CarLink fleet operations API",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/horizon": "^5.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "aws/aws-sdk-php": "^3.0",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "@php artisan test"},
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
    "extra": {"laravel": {"dont-discover": ["laravel/horizon"]}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
