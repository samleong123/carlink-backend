APP_NAME=CarLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000
# Explicit ingress peer CIDRs only; leave empty until verified. Never use '*'.
TRUSTED_CLOUDFLARE_PROXIES=
TRUSTED_FORWARDED_PROXIES=
CLOUDFLARE_PSEUDO_IPV4=false
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=carlink
DB_USERNAME=carlink
DB_PASSWORD=
DB_SSLMODE=prefer
LOG_DB_HOST=127.0.0.1
LOG_DB_PORT=5432
LOG_DB_DATABASE=carlink_logs
LOG_DB_USERNAME=carlink_logs
LOG_DB_PASSWORD=
LOG_DB_SSLMODE=prefer
REQUEST_LOG_SPOOL_PATH=
REQUEST_LOG_SPOOL_MAX_BYTES=104857600

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ABSOLUTE_LIFETIME=720
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=
# Include the deployed frontend hostname and backend hostname (for Swagger), with ports if needed; no URL schemes or paths.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CarLink
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
FILESYSTEM_DISK=s3

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5671
RABBITMQ_VHOST=carlink-local
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# The telemetry consumer requires verified TLS and a pre-provisioned queue.
RABBITMQ_TLS_CA_FILE=/etc/carlink/broker-tls/ca.pem
RABBITMQ_TELEMETRY_QUEUE=
RABBITMQ_EVENTS_QUEUE=
RABBITMQ_PUBLISHER_USER=
RABBITMQ_PUBLISHER_PASSWORD=
RABBITMQ_MQTT_EXCHANGE=amq.topic
# Optional: RabbitMQ Management HTTP API (e.g. private http://172.18.0.15:15672) to auto-provision device MQTT users/ACLs.
RABBITMQ_MANAGEMENT_URL=
RABBITMQ_MANAGEMENT_USER=
RABBITMQ_MANAGEMENT_PASSWORD=
RABBITMQ_MANAGEMENT_TIMEOUT=5
# Set true only after broker topic and queue ACLs have been verified.
BROKER_VERIFIED_TOPIC_ACLS=false
MQTT_PUBLIC_WSS_URL=
NFC_HMAC_KEY=
NFC_HMAC_KEY_VERSION=1
NFC_SHIFT_EXPIRY_HOURS=16
NFC_AUTH_DEBOUNCE_SECONDS=10
PAYMENT_GATEWAY_URL=https://gateway.example.com/api/generateLink
PAYMENT_GATEWAY_CHECKOUT_HOST=gateway.example.com
PAYMENT_GATEWAY_TOKEN=
PAYMENT_GATEWAY_CALLBACK_BASE_URL=
PAYMENT_GATEWAY_TIMEOUT=10

# Default-on SaaS rules. Existing organizations need a confirmed paid subscription before operational access.
SAAS_ENFORCE_SUBSCRIPTIONS=true
SAAS_MANAGED_DEVICES=true
DEVICE_CONFIG_SIGNING_KEY=
# Secure public broker URL emitted to the Pi; provisioning/ACL verification are separate operator work.
DEVICE_MQTT_URL=
GEMINI_API_KEY=
DTC_AI_MODEL=gemini-3.5-flash-lite
AUDIT_AI_MODEL=gemini-3.5-flash-lite
DTC_AI_TIMEOUT=90
